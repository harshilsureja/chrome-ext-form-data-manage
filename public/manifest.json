{
  "manifest_version": 3,
  "name": "Form Data Manager",
  "version": "1.0.0",
  "description": "Auto-fill forms, save forms with their field data and URL, re-fill them in one click, and browse your full form history.",
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Form Data Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["faker.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
