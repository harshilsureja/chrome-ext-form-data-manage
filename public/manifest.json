{
  "manifest_version": 3,
  "name": "Open Autofill – Form Filler & Saver",
  "short_name": "Open Autofill",
  "version": "1.0.0",
  "description": "Autofill forms, generate realistic test data, save filled forms and replay them in one click. 100% local.",
  "homepage_url": "https://harshilsureja.github.io/open-autofill/",
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["faker.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
